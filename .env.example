# Gemini (vision + RAG). GEMINI_API_KEY is preferred; API_KEY is accepted as fallback.
GEMINI_API_KEY=
API_KEY=

# Shared secret required on /api/search and /api/verify-media (X-API-Key or Bearer).
BACKEND_API_KEY=change-me-to-a-long-random-string

# Tavily web search
TAVILY_API_KEY=

# Comma-separated allowed frontend origins (no wildcards).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional Firestore ingestion (offline pipeline only)
APP_ID=truthlens
__firebase_config=
